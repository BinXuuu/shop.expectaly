# ============================================================
# 意料之中～意购（Expectaly Shop）环境变量示例
# 复制为 .env.local 后填写真实值；.env.local 不应提交到版本库。
# 本文件不得包含任何真实密钥。
# ============================================================

# ---- 站点基础信息 ----
NEXT_PUBLIC_SITE_NAME="意料之中～意购"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_MAIN_SITE_URL="https://expectaly.com"
NEXT_PUBLIC_DEFAULT_LOCALE="zh-CN"

# ---- Supabase（第一期数据与认证后端）----
# 本地开发阶段可留空，数据层将回退到内置模拟数据
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- 认证相关 ----
# 微信登录（第一期仅预留 provider，未配置时前端给出友好提示）
WECHAT_OAUTH_APP_ID=
WECHAT_OAUTH_APP_SECRET=
WECHAT_OAUTH_REDIRECT_URI="http://localhost:3000/auth/callback/wechat"

# 主站账号互通（预留，第一期不启用）
MAIN_SITE_SSO_ENABLED=false
MAIN_SITE_SHARED_COOKIE_DOMAIN=".expectaly.com"

# ---- 功能开关 ----
PAYMENT_ENABLED=false
WECHAT_LOGIN_ENABLED=false

# ---- 汇率服务（第一期使用后台可配置的模拟汇率，非必需外部 API）----
EXCHANGE_RATE_API_URL=
EXCHANGE_RATE_API_KEY=

# ---- 邮件通知（开发环境占位，不发送真实邮件）----
EMAIL_PROVIDER="dev-console"
EMAIL_FROM="no-reply@expectaly.com"

# ---- 短信通知（预留，第一期不接入真实短信网关）----
SMS_PROVIDER=
SMS_API_KEY=

# ---- 图片存储（第一期使用本地占位图，预留 Supabase Storage 适配层）----
STORAGE_PROVIDER="local-placeholder"
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET="product-media"
